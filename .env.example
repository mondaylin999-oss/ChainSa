# Myanmar EarthLens chatbot — copy this file to .env.local and fill in your keys.
# .env.local is git-ignored. NEVER prefix these with NEXT_PUBLIC_ (that would expose them in the browser).

# ---------- Primary AI provider: OpenRouter (FREE models only) ----------
# Get a key at https://openrouter.ai/keys . Do not buy credits if you want to stay 100% free.
OPENROUTER_API_KEY=
# Comma-separated, tried in order. Only "openrouter/free" or IDs ending in ":free" are accepted;
# anything else is ignored by the server.
OPENROUTER_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-120b:free
# Optional attribution headers sent to OpenRouter
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Myanmar EarthLens

# ---------- Backup AI provider: Groq (FREE plan) ----------
# Get a key at https://console.groq.com/keys . Keep the account on the Free plan (no billing added).
GROQ_API_KEY=
# Only models on the built-in free allowlist are accepted (openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b).
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
# If Groq adds a new free model, list it here to allow it explicitly.
GROQ_EXTRA_FREE_MODELS=

# ---------- NASA ----------
# NASA POWER needs no key.
# NASA FIRMS MAP_KEY (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/  — leave empty to disable fire data.
FIRMS_MAP_KEY=

# ---------- Safety / limits ----------
# Requests allowed per client per window
CHAT_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
# Set to true only behind a trusted reverse proxy (Vercel, Nginx) so X-Forwarded-For is used per user.
TRUST_PROXY=false
# Optional comma-separated list, e.g. https://earthlens.example.org . Empty = no origin check.
CHAT_ALLOWED_ORIGINS=
# strict = discard AI answers containing numbers not found in NASA data (recommended); warn = keep and log
CHAT_VERIFY_MODE=strict
AI_TIMEOUT_MS=25000
NASA_TIMEOUT_MS=20000

# ---------- Testing only ----------
# Point providers at a local mock server (http://localhost allowed). Leave empty in real use.
OPENROUTER_BASE_URL=
GROQ_BASE_URL=
NASA_POWER_BASE_URL=
